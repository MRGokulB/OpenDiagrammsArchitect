        B2 -->|Regulatory| B5[FDA Recalls Actor]
        B2 -->|Regulatory| B6[FDA Shortages Actor]
        B2 -->|News| B7[Company News Actor]
    end

    A1 --> B1
    A2 --> B1
    A3 --> B1

    subgraph Apify Cloud
        B3 --> C1((Run on Apify Cloud))
        B4 --> C1
        B5 --> C1
        B6 --> C1
        B7 --> C1
    end

    subgraph Webhook Processing
        C1 -->|Webhook POST| D1[Webhook Controller]
        D1 --> D2{Route by Actor ID}
        D2 -->|Social| D3[SocialIntelProcessor]
        D2 -->|Regulatory| D4[RegulatoryIntelProcessor]
        D2 -->|News| D5[NewsIntelProcessor]
    end

    subgraph Data Persistence
        D3 --> E1[(Update Lead — socialIntel)]
        D4 --> E2[(Create Trigger — recalls/shortages)]
        D5 --> E3[(Update Company — latestNews)]
    end

