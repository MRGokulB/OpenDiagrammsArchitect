flowchart TD
    subgraph Trigger Points
        A1[New Lead Created]
        A2[Scheduled Cron Job]
        A3[Manual Chat Command]
    end

    subgraph Apify Orchestration Layer
        B1[ApifyOrchestrator]
        B1 --> B2{Determine Scrape Type}
